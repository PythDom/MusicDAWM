From 904f99b56c5e6fa261fd3d2a97b8c1dc9411eeb6 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 23 Oct 2026 00:53:00 +0000
Subject: [PATCH] portaudio backend: link jack64 only when it is available

Native (MSYS2) Windows builds take the mingw/win32 branch, which always
linked jack64. MSYS2 has no jack64, so linking the backend failed.
Check for the library at configure time and only link it when found.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012woem7gpF63F73AqdVTFfU
---
 libs/backends/portaudio/wscript | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/libs/backends/portaudio/wscript b/libs/backends/portaudio/wscript
index 381f3de..f0122bf 100644
--- a/libs/backends/portaudio/wscript
+++ b/libs/backends/portaudio/wscript
@@ -12,6 +12,9 @@ def options(opt):
 def configure(conf):
     autowaf.check_pkg(conf, 'portaudio-2.0', uselib_store='PORTAUDIO', atleast_version='19')
     conf.check(header_name='pa_asio.h', define_name='WITH_ASIO', mandatory=False)
+    if conf.env['build_target'] == 'mingw' and sys.platform == "win32":
+        # a static portaudio built with JACK support needs it; MSYS2's does not
+        conf.check(lib='jack64', uselib_store='JACK64', mandatory=False)
 
 def build_portaudio (bld, name, defines):
     obj = bld(features = 'cxx cxxshlib')
@@ -29,7 +32,9 @@ def build_portaudio (bld, name, defines):
     obj.uselib   = 'PORTAUDIO GLIBMM XML'
     if bld.env['build_target'] == 'mingw' and sys.platform == "win32":
         obj.stlib = ['portaudio']
-        obj.lib = ['ole32', 'setupapi', 'uuid', 'winmm', 'ksuser', 'jack64']
+        obj.lib = ['ole32', 'setupapi', 'uuid', 'winmm', 'ksuser']
+        if bld.env['LIB_JACK64']:
+            obj.lib += ['jack64']
     obj.install_path  = os.path.join(bld.env['LIBDIR'], 'backends')
     obj.defines = ['PACKAGE="' + I18N_PACKAGE + '"',
                    'ARDOURBACKEND_DLL_EXPORTS',
-- 
2.43.0

